rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserVideo(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'quote', 'candidateName', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'quote', 'candidateName', 'generatedDate', 'thumbnailUrl', 'durationSec', 'videoUrl', 'promptUsed', 'createdAt'])
        && data.userId == userId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.quote is string && data.quote.size() > 0 && data.quote.size() <= 5000
        && data.candidateName is string && data.candidateName.size() <= 100
        && (!('generatedDate' in data) || (data.generatedDate is string && data.generatedDate.size() <= 100))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 500000))
        && (!('durationSec' in data) || data.durationSec is number)
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500000))
        && (!('promptUsed' in data) || (data.promptUsed is string && data.promptUsed.size() <= 10000))
        && data.createdAt is number;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // User-linked persistent video collection
    match /users/{userId}/videos/{videoId} {
      allow get: if isOwner(userId) && isValidId(videoId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(videoId)
                    && isValidUserVideo(request.resource.data, userId);
      allow update: if isOwner(userId)
                    && isValidId(videoId)
                    && isValidUserVideo(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(videoId);
    }
  }
}
